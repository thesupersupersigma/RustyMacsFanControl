/ghidra/
/*.gpr
/*.rep/
*.lock~

# Third-party tooling checked out locally (has its own repository)
/tools/

# Rust build output
target/

# Local editor / agent state
.claude/
.vscode/
.idea/
*.log

# Scratch files from spec-writing passes
/re/spec/parts/
